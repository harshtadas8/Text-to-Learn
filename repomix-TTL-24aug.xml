  const isActive = (path) => location.pathname === path;
  const linkClass = (path) => 
    `transition ${isActive(path) ? 'text-emerald-400 font-semibold' : 'hover:text-white'}`;

  return (
    <>
      {/* Overlay */}
      <div
        onClick={onClose}
        className="fixed inset-0 bg-black/60 z-40"
