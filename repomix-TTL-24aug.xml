const pdfParse = require('pdf-parse');
import { generateDiagnosticQuizWithGemini } from '../services/ai/gemini.service.js';

/* =====================================================
   POST /api/courses/diagnostic-quiz
===================================================== */
export async function generateDiagnosticQuizController(req, res) {
  try {
    const { topic, language = 'English', sourceMaterial = '' } = req.body;
    if (!topic) return res.status(400).json({ error: 'Topic is required' });
    
    const quiz = await generateDiagnosticQuizWithGemini(topic, language, sourceMaterial);
    res.json(quiz);
  } catch (error) {
    logger.error('Error generating diagnostic quiz:', error);
    res.status(500).json({ error: 'Failed to generate diagnostic quiz' });
  }
}

/* =====================================================
   POST /api/courses/extract-text
===================================================== */
export async function extractTextController(req, res) {
  try {
    if (!req.file) {
      return res.status(400).json({ error: 'No file uploaded' });
    }

    let text = '';
    const mimeType = req.file.mimetype;

    if (mimeType === 'application/pdf') {
      const data = await pdfParse(req.file.buffer);
      text = data.text;
    } else if (mimeType === 'text/plain') {
      text = req.file.buffer.toString('utf-8');
    } else {
      return res.status(400).json({ error: 'Unsupported file type. Only PDF and TXT are allowed.' });
    }

    if (text.length > 50000) {
      text = text.substring(0, 50000) + '... [TRUNCATED]';
    }

    res.json({ text });
  } catch (error) {
    logger.error('Error extracting text:', error);
    res.status(500).json({ error: 'Failed to extract text from file' });
  }
}
