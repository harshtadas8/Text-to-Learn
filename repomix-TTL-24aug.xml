          <Link
            to="/explore"
            onClick={onClose}
            className={linkClass("/explore")}
          >
            Explore
          </Link>

          {/* -------- LOGGED IN -------- */}
          {isAuthenticated && (
            <>
              <Link
                to="/courses"
                onClick={onClose}
                className={linkClass("/courses")}
              >
                My Courses
              </Link>

              <Link
                to="/room"
                onClick={onClose}
                className={linkClass("/room")}
              >
                Study Rooms
              </Link>

              <Link
                to="/review"
                onClick={onClose}
                className={linkClass("/review")}
              >
                Daily Review
              </Link>

              <Link
                to="/profile"
                onClick={onClose}
                className={linkClass("/profile")}
              >
                My Profile
              </Link>

              <button
                onClick={() => {
                  onClose();
                  logout({
                    logoutParams: {
                      returnTo: window.location.origin,
                    },
