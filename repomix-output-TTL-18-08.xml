        topic,
        level,
        language,
        goal,
        timeAvailable,
      });

      navigate(`/course/${res.data._id}`);
    } 
    catch (err) {
      console.error("Full Error:", err);
      
      // If Auth0 silent token fetch fails (e.g., due to new scopes or expired session)
      const errorStr = err?.message?.toLowerCase() || err?.error?.toLowerCase() || "";
