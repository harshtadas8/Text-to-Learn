    if (isAuthenticated) {
      const fetchStats = async () => {
        try {
          const res = await getDashboardAPI();
          if (res.success) {
            setStats(res.data.stats);
          }
        } catch (error) {
          console.error("Failed to fetch stats", error);
        } finally {
          setFetchingStats(false);
        }
      };
      fetchStats();
    } else {
      setFetchingStats(false);
    }
  }, [isAuthenticated]);

